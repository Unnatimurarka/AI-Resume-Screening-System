# Copy to .env and fill in. Nothing here is required: without keys the
# pipeline runs deterministically (no LLM review, unauthenticated GitHub).

# LLM review: "none" (default) or "anthropic"
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=60
# Maximum points the LLM may add to / remove from AI project depth
LLM_MAX_ADJUSTMENT=8

# GitHub: optional token raises the API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Concurrency for per-resume work (LLM + GitHub calls)
MAX_WORKERS=4
